# Optional defaults for the Colab wrapper scripts in scripts/.
#
# This repository stores NO credentials. Authentication is handled entirely by
# the official `google-colab-cli` tool, which caches an OAuth refresh token in
# your own home directory (default: ~/.config/colab-cli/token.json). Nothing in
# this file is secret; it only lets you avoid retyping a default GPU or session
# name on every call.

# Default accelerator for `colab new` / `colab run` when none is passed.
# One of: T4, L4, G4, H100, A100 (empty means CPU runtime).
COLAB_DEFAULT_GPU=

# Default session name used by the helper scripts.
COLAB_SESSION_NAME=colab-job
